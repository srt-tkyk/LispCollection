.PHONY: run gp video video-gp repl clean

run:       ; ./run.sh clos
gp:        ; ./run.sh gp
video:     ; ./run.sh video
video-gp:  ; ./run.sh video-gp
repl:      ; ./run.sh repl
# 生成物だけを消す。コミット済みの demo.mp4 は残すので *.mp4 とは書かない。
clean:     ; rm -f alife.mp4 alife-gp.mp4 *.fasl; rm -rf /tmp/alife-frames
